# Copiá este archivo a .env.local y completá. Nunca subas claves reales al repositorio.

# URL pública del sitio (metadatos, Open Graph, sitemap). Si empieza con https://,
# se activan HSTS y upgrade-insecure-requests (por http romperían los pedidos a localhost).
NEXT_PUBLIC_SITIO_URL=http://localhost:3000

# Clave de acceso a /inversores. En desarrollo, si falta, se usa "quvant-demo".
# En producción, si falta, la presentación queda bloqueada.
INVERSORES_KEY=

# Clave del panel interno /panel (solicitudes de demo: datos personales).
# En desarrollo, si falta, se usa "quvant-panel". En producción, si falta, el panel queda cerrado.
PANEL_KEY=

# Secreto para firmar la sesión de la demo (HMAC-SHA256, 32+ caracteres).
# En desarrollo, si falta, se usa uno fijo de desarrollo (con aviso en consola).
SESION_SECRETO=

# Solo para pruebas de producción local: "1" permite el secreto de desarrollo con NODE_ENV=production.
# Se llamaba YUNQUE_PERMITIR_SECRETO_DEV: el nombre viejo se sigue leyendo como respaldo por un tiempo.
QUVANT_PERMITIR_SECRETO_DEV=

# Supabase (opcional). Sin estas variables la app corre en MODO DEMO:
# datos de la empresa demo en el navegador y servidor de sincronización emulado.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo para scripts de administración del lado servidor. Jamás en el cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Monitoreo de errores (opcional): webhook que recibe cada error en JSON. Sin esto se registra en la consola del servidor.
MONITOREO_WEBHOOK=
